{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample API",
    "version": "1.0.0"
  },
  "paths": {
    "/public/status": {
      "get": {
        "summary": "Public health check endpoint",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/user/profile": {
      "get": {
        "summary": "User Profile Data",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User details" }
        }
      }
    },
    "/admin/settings": {
      "post": {
        "summary": "Admin settings update",
        "responses": {
          "200": { "description": "Settings updated" }
        }
      }
    }
  }
}